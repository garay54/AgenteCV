# Copia este archivo como .env. Nunca confirmes .env en Git.
# Clave de entrada al agente. Debe ser distinta de OPENAI_API_KEY.
AGENT_API_KEY=genera_una_clave_independiente

OPENAI_API_KEY=tu_clave_de_openai_aqui
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

APP_ENVIRONMENT=development
APP_VERSION=0.1.0
KNOWLEDGE_DIR=knowledge
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=banorte_cv_v1

RAG_TOP_K=4
RAG_CANDIDATE_K=16
RAG_MAX_PER_DOCUMENT=2
# Dejar vacío hasta calibrarlo con la evaluación.
RAG_MIN_SCORE=

RAG_CHUNK_MIN_TOKENS=150
RAG_CHUNK_TARGET_TOKENS=350
RAG_CHUNK_MAX_TOKENS=450
RAG_CHUNK_OVERLAP_TOKENS=50
