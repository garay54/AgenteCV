# Copia este archivo como .env. Nunca confirmes .env en Git.
# Clave de entrada al agente. Debe ser distinta de OPENAI_API_KEY.
AGENT_API_KEY=genera_una_clave_independiente
# Límite total del cuerpo HTTP (512 KiB) y solicitudes por credencial.
MAX_REQUEST_BODY_BYTES=524288
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=20

OPENAI_API_KEY=tu_clave_de_openai_aqui
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_TEXT_VERBOSITY=low
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
GENERATION_MAX_OUTPUT_TOKENS=500

APP_ENVIRONMENT=development
APP_VERSION=0.1.0
KNOWLEDGE_DIR=knowledge
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=agente_cv_v1

RAG_TOP_K=4
RAG_CANDIDATE_K=16
RAG_MAX_PER_DOCUMENT=2
# Penalización pequeña para fragmentos genéricos que mezclan muchas fuentes.
RAG_SOURCE_BREADTH_PENALTY=0.005
# Refuerzo acotado para alias y términos literales dentro de los candidatos vectoriales.
RAG_LEXICAL_BONUS=0.05
# Dejar vacío hasta calibrarlo con la evaluación.
RAG_MIN_SCORE=

RAG_CHUNK_MIN_TOKENS=150
RAG_CHUNK_TARGET_TOKENS=350
RAG_CHUNK_MAX_TOKENS=450
RAG_CHUNK_OVERLAP_TOKENS=50
