{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "python -m scripts.ensure_index && uvicorn app.main:app --host 0.0.0.0 --port $PORT --no-access-log",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  }
}
