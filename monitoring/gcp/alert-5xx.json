{
  "displayName": "Agente CV - errores 5xx",
  "documentation": {
    "content": "Cloud Run ha respondido con errores 5xx durante dos minutos.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "Respuestas 5xx",
      "conditionThreshold": {
        "filter": "resource.type = \"cloud_run_revision\" AND resource.label.service_name = \"agente-cv\" AND metric.type = \"run.googleapis.com/request_count\" AND metric.label.response_code_class = \"5xx\"",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": [
              "resource.label.service_name"
            ]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "120s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "notificationChannels": [],
  "alertStrategy": {
    "autoClose": "1800s"
  },
  "userLabels": {
    "service": "agente-cv",
    "severity": "critical"
  }
}
